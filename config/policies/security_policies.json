{
  "version": "1.0",
  "policies": [
    {
      "id": "scope_validation",
      "name": "Network Scope Validation",
      "description": "Prevent scanning outside authorized ranges",
      "action": "network_scan",
      "condition": "target NOT IN authorized_scope",
      "effect": "block_and_alert",
      "severity": "high"
    },
    {
      "id": "dual_authorization",
      "name": "Dual Authorization for Critical Infrastructure",
      "description": "Require two approvers for critical system changes",
      "action": "contain_critical_infrastructure",
      "condition": "impact == critical AND authorization.count < 2",
      "effect": "block_pending_approval",
      "severity": "critical"
    },
    {
      "id": "data_minimization",
      "name": "Data Minimization for AI Processing",
      "description": "Only process necessary data fields",
      "action": "ai_analysis",
      "condition": "telemetry.fields NOT IN required_for_task",
      "effect": "redact_and_log",
      "severity": "medium"
    },
    {
      "id": "bias_threshold",
      "name": "AI Bias Detection Threshold",
      "description": "Flag AI decisions with high bias scores",
      "action": "ai_decision",
      "condition": "bias_score > 0.15",
      "effect": "flag_for_review",
      "severity": "medium"
    },
    {
      "id": "privacy_check",
      "name": "PII Processing Authorization",
      "description": "Ensure legal basis for PII processing",
      "action": "process_pii",
      "condition": "data.classification == pii AND purpose NOT IN authorized_purposes",
      "effect": "block_and_escalate",
      "severity": "high"
    },
    {
      "id": "redteam_scope",
      "name": "Red Team Test Environment Restriction",
      "description": "Red team tests only in authorized environments",
      "action": "adversarial_test",
      "condition": "target_env != test AND test_env_only == true",
      "effect": "block_and_alert",
      "severity": "critical"
    }
  ]
}
