# CyberSec AI Ecosystem — Environment Configuration
# Copy to .env and fill with your values

# Database
DB_PASSWORD=change_me_to_a_strong_database_password

# Message Broker (Kafka)
KAFKA_BROKER=kafka:29092

# External API Keys
NVD_API_KEY=your_nvd_api_key_here
VULDB_API_KEY=your_vuldb_api_key_here
# Set false when product/CPE fingerprints must not be sent to the public NVD API.
VULN_NVD_LOOKUPS_ENABLED=true
MISP_URL=https://misp.yourorg.com
MISP_API_KEY=your_misp_api_key_here
VIRUSTOTAL_API_KEY=your_vt_api_key_here

# Security Platforms
EDR_API_KEY=your_edr_api_key_here
FIREWALL_API_KEY=your_firewall_api_key_here
SIEM_URL=https://siem.yourorg.com
SIEM_API_KEY=your_siem_api_key_here

# API / HITL authorization
API_ADMIN_TOKEN=change_me_to_a_long_random_value

# JWT & Encryption
JWT_SECRET=your_jwt_secret_min_32_chars

# Grafana
GRAFANA_PASSWORD=admin

# LLM / AI Studio (if using external LLM)
AI_STUDIO_API_KEY=your_google_ai_studio_key
OPENAI_API_KEY=your_openai_api_key

# Compliance
DPO_EMAIL=dpo@yourorg.com
LEGAL_CONTACT=legal@yourorg.com

# Phase 3 Knowledge Graph
GRAPH_REBUILD_INTERVAL=120

# API Gateway & Deployment
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3001,https://cybersecia.vercel.app

# Frontend Deploy (Vite)
VITE_API_URL=https://cybersecia-api.onrender.com
VITE_WS_URL=wss://cybersecia-api.onrender.com/ws
